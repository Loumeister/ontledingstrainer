{
  "name": "ontleedlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/security-check.mjs assets",
    "preview": "vite preview",
    "test": "vitest run",
    "docs:zinnen": "vitest run src/logic/sentenceOverview.test.ts -u",
    "clean-install": "rm -rf node_modules package-lock.json && npm install",
    "test:backend": "npm --prefix worker test",
