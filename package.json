    "security:assets": "node scripts/security-check.mjs assets",
    "security:git": "node scripts/security-check.mjs git",
    "security:history": "node scripts/security-check.mjs history"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "0.27.0"
  }
