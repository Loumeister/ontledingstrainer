{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ontleedlab",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 * * * *"] },
  "assets": {
    "directory": "../dist", "binding": "ASSETS",
    "run_worker_first": true, "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ORIGIN": "https://ontleedlab.nl",
    "GOOGLE_CLIENT_ID": "CONFIGURE.apps.googleusercontent.com",
    "REPORTS_PER_DAY": "10000", "SESSION_SECONDS": "3600"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "ontleedlab",
    "database_id": "CONFIGURE_D1_DATABASE_ID", "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "REPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
